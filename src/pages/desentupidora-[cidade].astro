---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaButtons from '../components/CtaButtons.astro';
import { site, whatsappCidade } from '../config/site';

/** Gera página só para cidades com lista de bairros confirmada pelo cliente. */
export async function getStaticPaths() {
	const cidades = await getCollection('cidades');
	return cidades
		.filter((c) => (c.data.bairros?.length ?? 0) > 0)
		.map((cidade) => ({
			params: { cidade: cidade.id },
			props: { cidade },
		}));
}

const { cidade } = Astro.props;
const nome = cidade.data.nome;
const bairros = cidade.data.bairros ?? [];

const servicos = (await getCollection('servicos')).sort((a, b) => a.data.ordem - b.data.ordem);

const faqBase = (await getCollection('faq'))
	.filter((item) => ['atendimento-24h', 'taxa-deslocamento', 'orcamento-gratis'].includes(item.id))
	.sort((a, b) => a.data.ordem - b.data.ordem);

const faqs = [
	{
		pergunta: `A Remax atende todos os bairros de ${nome}?`,
		resposta: `Sim. Atendemos todos os bairros de ${nome}, como ${bairros.slice(0, 4).join(', ')} e os demais da lista desta página.`,
	},
	...faqBase.map((item) => ({ pergunta: item.data.pergunta, resposta: item.data.resposta })),
];

const siteUrl = site.url.replace(/\/$/, '');
const pageUrl = `${siteUrl}/desentupidora-${cidade.id}/`;

const areaServed = [
	{
		'@type': 'City',
		name: nome,
		containedInPlace: { '@type': 'State', name: 'São Paulo' },
	},
];

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Início', item: `${siteUrl}/` },
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Área de atendimento',
			item: `${siteUrl}/area-de-atendimento/`,
		},
		{ '@type': 'ListItem', position: 3, name: `Desentupidora em ${nome}`, item: pageUrl },
	],
};

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((item) => ({
		'@type': 'Question',
		name: item.pergunta,
		acceptedAnswer: { '@type': 'Answer', text: item.resposta },
	})),
};
---

<BaseLayout
	title={`Desentupidora em ${nome} SP 24h | Desentupidora Remax`}
	description={`Desentupidora 24 horas em ${nome} SP. Atendemos todos os bairros: vaso sanitário, pia e esgoto. Orçamento grátis e sem taxa de deslocamento.`}
	exactTitle={true}
	areaServed={areaServed}
	jsonLdExtra={[breadcrumbJsonLd, faqJsonLd]}
>
	<section class="section-space" aria-labelledby="cidade-h1">
		<div class="container-site">
			<Breadcrumb
				items={[
					{ label: 'Início', href: '/' },
					{ label: 'Área de atendimento', href: '/area-de-atendimento/' },
					{ label: `Desentupidora em ${nome}` },
				]}
			/>
			<h1 id="cidade-h1" class="mt-4 max-w-3xl text-slate-900">
				Desentupidora em {nome} SP 24 horas
			</h1>
			<p class="mt-[var(--spacing-stack)] max-w-3xl text-slate-700">
				A Desentupidora Remax atende todos os bairros de {nome}. Vaso sanitário, pia e esgoto
				entupidos têm solução: chame a qualquer hora, inclusive fins de semana e feriados.
			</p>
			<CtaButtons
				class="mt-6"
				whatsappLabel={`Pedir atendimento em ${nome}`}
				phoneLabel={`Ligar ${site.telefone}`}
			/>
		</div>
	</section>

	<section class="section-space bg-slate-50" aria-labelledby="bairros-titulo">
		<div class="container-site">
			<SectionHeading id="bairros-titulo" title={`Bairros atendidos em ${nome}`} />
			<p class="mt-[var(--spacing-stack)] max-w-3xl text-slate-700">
				Atendemos todos os bairros de {nome}, entre eles:
			</p>
			<ul class="mt-[var(--spacing-block)] grid list-none gap-x-6 gap-y-2 p-0 sm:grid-cols-2 lg:grid-cols-3">
				{bairros.map((bairro) => <li class="text-slate-800">{bairro}</li>)}
			</ul>
			<a
				href={whatsappCidade(nome)}
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-whatsapp mt-6 w-full sm:w-auto"
				aria-label={`Pedir atendimento em ${nome} pelo WhatsApp`}
			>
				Pedir atendimento em {nome}
			</a>
		</div>
	</section>

	<section class="section-space" aria-labelledby="servicos-cidade-titulo">
		<div class="container-site">
			<SectionHeading id="servicos-cidade-titulo" title={`Serviços de desentupimento em ${nome}`} />
			<div class="mt-[var(--spacing-block)] grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{
					servicos.map((servico) => (
						<ServiceCard
							title={servico.data.h1}
							resumo={servico.data.resumo}
							href={`/servicos/${servico.id}/`}
						/>
					))
				}
			</div>
		</div>
	</section>

	<section class="section-space bg-slate-50" aria-labelledby="faq-cidade-titulo">
		<div class="container-site max-w-3xl">
			<SectionHeading id="faq-cidade-titulo" title="Perguntas frequentes" />
			<div class="mt-[var(--spacing-block)]">
				{
					faqs.map((item) => (
						<details class="faq-item">
							<summary>{item.pergunta}</summary>
							<p class="faq-answer">{item.resposta}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section class="section-space bg-primary-50" aria-labelledby="cta-cidade-titulo">
		<div class="container-site max-w-3xl text-center">
			<h2 id="cta-cidade-titulo" class="text-slate-900">Entupiu em {nome}? Fale com a gente agora</h2>
			<CtaButtons class="mt-6 justify-center" />
		</div>
	</section>
</BaseLayout>
