---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButtons from '../components/CtaButtons.astro';
---

<BaseLayout
	title="Página não encontrada"
	description="A página que você procurou não existe. Fale com a Desentupidora Remax ou volte ao início."
	noindex={true}
>
	<section class="section-space" aria-labelledby="erro-404">
		<div class="container-site max-w-2xl text-center">
			<p class="text-sm font-bold uppercase tracking-wide text-accent">Erro 404</p>
			<h1 id="erro-404" class="mt-2 text-slate-900">Página não encontrada</h1>
			<p class="mt-[var(--spacing-stack)] text-slate-700">
				O endereço pode ter mudado ou não existe mais. Se você precisa de desentupimento agora,
				fale conosco — estamos de plantão 24 horas.
			</p>

			<nav aria-label="Links úteis" class="mt-6 flex flex-wrap justify-center gap-3">
				<a href="/" class="btn btn-secondary">Início</a>
				<a href="/servicos/" class="btn btn-secondary">Serviços</a>
				<a href="/area-de-atendimento/" class="btn btn-secondary">Área de atendimento</a>
			</nav>

			<CtaButtons class="mt-8 justify-center" />
		</div>
	</section>
</BaseLayout>
