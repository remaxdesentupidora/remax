---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import logo from '../assets/images/logo-desentupidora-remax.png';

const navItems = [
	{ href: '/', label: 'Início' },
	{ href: '/servicos/', label: 'Serviços' },
	{ href: '/area-de-atendimento/', label: 'Área de Atendimento' },
	{ href: '/sobre-nos/', label: 'Sobre' },
	{ href: '/contato/', label: 'Contato' },
];

const pathname = Astro.url.pathname.endsWith('/')
	? Astro.url.pathname
	: `${Astro.url.pathname}/`;

function isActive(href: string): boolean {
	if (href === '/') return pathname === '/';
	return pathname === href || pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-bg/95 backdrop-blur-sm">
	<div class="container-site flex items-center justify-between gap-4 py-3">
		<a
			href="/"
			class="inline-flex items-center no-underline"
			aria-label={`${site.nome} — página inicial`}
		>
			<Image
				src={logo}
				alt="Desentupidora Remax – Atendimento 24 horas"
				width={180}
				height={56}
				format="webp"
				quality="mid"
				loading="eager"
				fetchpriority="auto"
				class="h-10 w-auto sm:h-12"
			/>
		</a>

		<input type="checkbox" id="nav-toggle" class="peer sr-only" />
		<label
			for="nav-toggle"
			class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-md border border-slate-200 text-primary md:hidden"
			aria-label="Abrir ou fechar menu de navegação"
		>
			<span class="sr-only">Menu</span>
			<svg
				class="h-6 w-6"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="M4 7h16M4 12h16M4 17h16"></path>
			</svg>
		</label>

		<nav
			aria-label="Principal"
			class="absolute left-0 right-0 top-full hidden border-b border-slate-200 bg-bg peer-checked:block md:static md:block md:border-0"
		>
			<ul
				class="container-site flex flex-col gap-1 py-4 md:flex-row md:items-center md:gap-1 md:py-0 lg:gap-2"
			>
				{
					navItems.map((item) => {
						const active = isActive(item.href);
						return (
							<li>
								<a
									href={item.href}
									class:list={[
										'block rounded-md px-3 py-2.5 text-sm font-bold no-underline md:py-2',
										active
											? 'bg-primary-50 text-primary'
											: 'text-slate-800 hover:bg-primary-50 hover:text-primary',
									]}
									aria-current={active ? 'page' : undefined}
								>
									{item.label}
								</a>
							</li>
						);
					})
				}
				<li class="mt-2 md:ml-2 md:mt-0">
					<a
						href={`tel:${site.telefoneE164}`}
						class="btn btn-primary w-full md:w-auto"
						aria-label={`Ligar para ${site.telefone}`}
					>
						Ligar {site.telefone}
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>
