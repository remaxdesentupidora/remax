---
interface Props {
	title: string;
	resumo: string;
	href: string;
	headingLevel?: 2 | 3;
}

const { title, resumo, href, headingLevel = 3 } = Astro.props;
const HeadingTag = headingLevel === 2 ? 'h2' : 'h3';
---

<article class="flex h-full flex-col border-t-4 border-primary bg-slate-50 p-5 shadow-[var(--shadow-soft)]">
	<HeadingTag class="text-slate-900">
		<a href={href} class="text-inherit no-underline hover:text-primary">
			{title}
		</a>
	</HeadingTag>
	<p class="mt-3 flex-1 text-slate-700">{resumo}</p>
	<a
		href={href}
		class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-primary no-underline hover:text-primary-700"
	>
		Saiba mais
		<span aria-hidden="true">→</span>
	</a>
</article>
